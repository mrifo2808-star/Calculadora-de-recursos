# Copiar este archivo a ".env" (o ".env.production") y completar con los valores reales
# del proyecto de Supabase (Project Settings -> API en el dashboard de supabase.com).
#
# La "anon key" esta disenada por Supabase para ser publica (queda embebida en el
# JS del sitio, como el config de Firebase) — la seguridad real la da Row Level
# Security en las tablas, no ocultar esta key. Por eso este .env SI se commitea al
# repo (no esta en .gitignore) una vez completado con los valores reales.
#
# NUNCA pongas aqui la "service_role key" — esa si es secreta y nunca debe llegar
# al frontend ni a un repo publico.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL publica del Worker-proxy de Cloudflare que sirve el catalogo de tasas desde
# SharePoint (ver worker-catalogo/README.md para desplegarlo). Esta URL NO es secreta —
# es solo el endpoint del proxy; el token real de SharePoint vive como secret DENTRO del
# Worker, nunca aca ni en ningun archivo de este repo. Sin esta variable, la
# sincronizacion con SharePoint queda deshabilitada (el boton "Actualizar catálogo" no
# aparece) pero el resto de la app funciona igual — la carga manual de Excel del
# catalogo sigue siendo el respaldo.
VITE_CATALOGO_WORKER_URL=https://welearn-catalogo-proxy.tu-subdominio.workers.dev
